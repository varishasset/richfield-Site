<body>
  <header>
    <h1>Feature Requests and Voting</h1>
    <p>College students and staff can submit feature requests and vote on them!</p>
  </header>

  <main>
    <section class="form-section">
      <h2>Submit Your Feature Request</h2>
      <form id="requestForm">
        <input type="text" id="featureInput" placeholder="Enter feature request" required>
        <button type="submit">Submit Request</button>
      </form>
    </section>

    <section class="suggestions-section">
      <h2>Submitted Feature Requests</h2>
      <ul id="suggestionsList">
        <!-- List of suggestions will appear here -->
      </ul>
    </section>
  </main>

  <footer>
    <p>Powered by Simple Web Technologies</p>
  </footer>

  <script>
    // Get the DOM elements
    const requestForm = document.getElementById('requestForm');
    const featureInput = document.getElementById('featureInput');
    const suggestionsList = document.getElementById('suggestionsList');

    // Array to store feature requests
    let featureRequests = [];

    // Handle form submission
    requestForm.addEventListener('submit', function (e) {
      e.preventDefault();

      // Get the feature request from the input field
      const featureRequest = featureInput.value;

      // Add the new feature request to the array
      featureRequests.push({ name: featureRequest, votes: 0 });

      // Clear the input field
      featureInput.value = '';

      // Re-render the list
      renderFeatureRequests();
    });

    // Function to render the list of feature requests
    function renderFeatureRequests() {
      suggestionsList.innerHTML = ''; // Clear the list before rendering

      // Loop through the feature requests and add them to the list
      featureRequests.forEach((request, index) => {
        const li = document.createElement('li');
        li.innerHTML = `
          <span>${request.name}</span>
          <div>
            <button class="vote-button" onclick="vote(${index})">Vote (${request.votes})</button>
          </div>
        `;
        suggestionsList.appendChild(li);
      });
    }

    // Function to handle voting
    function vote(index) {
      // Increment the vote count for the selected request
      featureRequests[index].votes++;

      // Re-render the list after voting
      renderFeatureRequests();
    }
  </script>
</body>
